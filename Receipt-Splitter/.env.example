# Get a free API key at https://aistudio.google.com/apikey
# The scan server reads GEMINI_API_KEY, or this Expo public name as a fallback.
GEMINI_API_KEY=your_api_key_here
EXPO_PUBLIC_GEMINI_API_KEY=your_api_key_here

# Optional. Defaults to this computer on port 8787.
# EXPO_PUBLIC_SCAN_API_URL=http://localhost:8787
